{% extends "partials/layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "moj/components/add-another/macro.njk" import mojAddAnother %}

{% set pageTitle = "Enter an email address" %}

{% block content %}
  <div class="govuk-grid-row govuk-body">
    <div class="govuk-grid-column-three-quarters">
      <span class="govuk-hint">Email official visit details to visitors</span>
      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>
    </div>
  </div>
  <div class="govuk-grid-row govuk-body">
    <div class="govuk-grid-column-three-quarters">
      <p class="govuk-body">
        {% if action === 'cancel' %}
          An email will be sent confirming the cancellation of this official visit.
        {% else %}
          An email will be sent confirming the details of this official visit.
        {% endif %}
      </p>

      <form method="POST">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}"/>

        {% set items = [] %}
        {% for address in formResponses.emailAddresses %}
          {% set fieldName = "emailAddresses[" + loop.index0 + "]" %}
          {% set itemHtml %}
            {{ govukInput({
              id: fieldName,
              name: fieldName,
              label: {
                html: 'Enter an email address <span class="govuk-visually-hidden moj-add-another__label-suffix">for email address ' + loop.index + '</span>'
              },
              classes: "govuk-input--width-20",
              inputmode: "email",
              autocomplete: "email",
              spellcheck: false,
              value: address,
              attributes: {
                "data-name": "emailAddresses[%index%]",
                "data-id": "emailAddresses[%index%]",
                "data-label": "Enter an email address"
              }
            }) }}
          {% endset %}
          {% set items = (items.push({
            fieldset: { html: itemHtml },
            errorMessage: validationErrors | findError(fieldName)
          }), items) %}
        {% endfor %}

        {{ mojAddAnother({
          id: "emailAddresses",
          itemLabel: "Email address",
          layout: "inline",
          items: items
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: 'Continue', preventDoubleClick: true }) }}
          <a class="govuk-link govuk-link--no-visited-state" href="{{ back }}">Cancel and return to homepage</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
