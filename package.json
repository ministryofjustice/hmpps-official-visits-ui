{
  "name": "hmpps-official-visits-ui",
  "version": "0.0.1",
  "description": "HMPPS Official Visits Ui",
  "repository": "git@github.com:ministryofjustice/hmpps-official-visits-ui.git",
  "license": "MIT",
  "scripts": {
    "prepare": "hmpps-precommit-hooks-prepare",
    "watch-ts": "tsc -w",
    "build": "node esbuild/esbuild.config.js --build",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild/esbuild.config.js --build --watch\" \"node esbuild/esbuild.config.js --dev-server\"",
    "start-feature": " node $NODE_DEBUG_OPTION --env-file=feature.env dist/server.js | bunyan -o short",
    "start-feature:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild/esbuild.config.js  --build --watch \" \"node esbuild/esbuild.config.js --dev-test-server\"",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests",
    "test": "TZ=utc jest",
    "test:ci": "TZ=utc jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "better-audit": "better-npm-audit audit",
    "int-test": "npx playwright test",
    "int-test-ui": "npx playwright test --ui",
    "int-test-init:ci": "npx playwright install",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm i && npm run build",
    "setup": "npm ci && hmpps-npm-script-run-allowlist"
  },
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1136.0",
    "@aws-sdk/core": "3.978.0",
    "@axe-core/playwright": "^4.13.0",
    "@microsoft/applicationinsights-web": "3.4.4",
    "@ministryofjustice/frontend": "11.1.0",
    "@ministryofjustice/hmpps-auth-clients": "^3.0.0",
    "@ministryofjustice/hmpps-connect-dps-components": "^6.3.5",
    "@ministryofjustice/hmpps-monitoring": "^2.1.0",
    "@ministryofjustice/hmpps-rest-client": "^2.2.0",
    "applicationinsights": "^2.9.8",
    "body-parser": "^2.3.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "compression": "^1.8.2",
    "connect-flash": "^0.1.1",
    "connect-redis": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "govuk-frontend": "6.5.1",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "moment": "2.31.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "qs": "6.16.0",
    "redis": "^6.2.1",
    "superagent": "^10.3.0",
    "uuid": "14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^5.0.0",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@ministryofjustice/hmpps-precommit-hooks": "^3.0.2",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.6",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "audit-ci": "^7.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "better-npm-audit": "^3.11.0",
    "cheerio": "1.2.0",
    "chokidar": "^5.0.0",
    "concurrently": "10.0.5",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.7.0",
    "glob": "^13.0.6",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "17.0.0",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.5.1",
    "nock": "^14.0.17",
    "openapi-typescript": "^7.13.0",
    "playwright-ctrf-json-reporter": "^0.0.29",
    "prettier": "^3.9.8",
    "prettier-plugin-jinja-template": "^2.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@jgoz/esbuild-plugin-typecheck": {
      "esbuild": "$esbuild"
    },
    "nunjucks": {
      "chokidar": "$chokidar"
    },
    "mocha": {
      "diff": "8.0.3"
    },
    "@aws-sdk/xml-builder": {
      "fast-xml-parser": "5.11.1"
    },
    "openapi-typescript": {
      "typescript": "$typescript",
      "js-yaml": "5.4.2"
    },
    "brace-expansion": "5.0.12",
    "js-yaml": "5.4.2",
    "shell-quote": "1.10.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "moment": "$moment"
  }
}
